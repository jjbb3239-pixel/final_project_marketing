{
  "buildCommand": "python3 ../tools/sync_landing.py build",
  "outputDirectory": "dist",
  "installCommand": "",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(assets|wireframe/assets|wireframe/blog/assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
